# Stellar network
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Registered issuer's Stellar address (the public side of ISSUER_PRIVATE_KEY)
NEXT_PUBLIC_ISSUER_ADDRESS=

# Optional JSON map of issuer address → display name for /issuer dropdown.
# On-chain metadata (set via set_issuer_metadata) is preferred when available;
# this env var serves as a fallback for issuers without on-chain metadata.
# NEXT_PUBLIC_ISSUER_NAMES={"GABC…":"StellarCred Authority","GDEF…":"Partner Bank"}

# Base URL the SDK uses when building verify links (buildVerifyUrl), and the
# dapp metadata URL/icon WalletConnect shows in the wallet's pairing prompt.
NEXT_PUBLIC_STELLARCRED_BASE_URL=https://stellarcred.xyz

# WalletConnect project ID (free, from https://cloud.reown.com) — enables
# WalletConnect as a wallet option. Freighter/Albedo/xBull/Rabet/Lobstr/Hana
# work via the Stellar Wallets Kit without this; unset = WalletConnect is
# omitted from the wallet-picker, everything else still works.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Issuer signing key — SERVER ONLY, never prefixed NEXT_PUBLIC_.
# 64-char hex secp256k1 private key whose pubkey is registered in IssuerRegistry.
ISSUER_PRIVATE_KEY=

# Deployed contract IDs (fill in after running scripts/deploy.sh)
NEXT_PUBLIC_ISSUER_REGISTRY_ID=
NEXT_PUBLIC_CREDENTIAL_VERIFIER_ID=
NEXT_PUBLIC_PROOF_REGISTRY_ID=
NEXT_PUBLIC_GATED_POOL_ID=

# Persona KYC (optional — unset = demo mode, identity verification skipped)
# Create templates at https://app.withpersona.com → Inquiries → Templates
# Government ID flow — issues kyc, age, and jurisdiction credentials.
# If PERSONA_API_KEY is set, PERSONA_KYC_TEMPLATE_ID must also be set.
PERSONA_API_KEY=
PERSONA_KYC_TEMPLATE_ID=

# Plaid balance attestation (optional — unset = mock mode, balance always passes)
# Get credentials at https://dashboard.plaid.com — use sandbox for testing.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ACCESS_TOKEN=
PLAID_ENV=sandbox

# Log level for structured logging (fatal, error, warn, info, debug, trace, default: info)
LOG_LEVEL=info

# Production origin for CORS on /api/* routes — set to your deployed app URL
# (e.g. https://stellarcred.xyz). Falls back to http://localhost:3000 in dev
# if unset; must be set correctly in production or CORS will be ineffective.
APP_ORIGIN=
# Mock balance used when PLAID_ACCESS_TOKEN is not configured
PLAID_MOCK_BALANCE=50000