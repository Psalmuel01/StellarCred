DB_DRIVER=sqlite
SQLITE_PATH=./data/indexer.db
DATABASE_URL=postgres://indexer:indexer@localhost:5432/indexer

RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
PROOF_REGISTRY_CONTRACT_ID=

POLL_INTERVAL_MS=5000
EVENT_PAGE_LIMIT=100
START_LEDGER=0

# Number of ledgers to lag behind the network head before persisting events.
# This prevents near-head reorgs from corrupting indexed data.
# Default: 6 (≈30 seconds at ~5 s/ledger on Stellar).
FINALITY_LAG=6

PORT=4100

# CORS allowlist: comma-separated list of allowed origins or "*"
# Default in development: http://localhost:3000
# Default in production: same-origin / deny cross-origin
CORS_ORIGIN=http://localhost:3000

# Rate limiting (per-IP fixed window)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
RATE_LIMIT_ENABLED=true
